# Alpaca API Configuration
# Sign up for free at: https://app.alpaca.markets/signup

# Paper Trading (Free - for practice)
ALPACA_API_KEY=your_paper_trading_key_here
ALPACA_SECRET_KEY=your_paper_trading_secret_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Live Trading (Optional - when ready for real money)
# ALPACA_API_KEY=your_live_trading_key_here
# ALPACA_SECRET_KEY=your_live_trading_secret_here
# ALPACA_BASE_URL=https://api.alpaca.markets

# To get started:
# 1. Go to https://app.alpaca.markets/signup
# 2. Create a free account
# 3. Navigate to API Keys section
# 4. Generate Paper Trading API keys
# 5. Copy keys to .env.local (create this file, don't commit it!)
